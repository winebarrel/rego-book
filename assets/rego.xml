<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!-- Rego 用のシンタックスハイライト定義（この本のために作成） -->
<language name="Rego" section="Sources" version="1" kateversion="5.0" extensions="*.rego" mimetype="text/x-rego" license="CC0-1.0">
  <highlighting>
    <list name="keywords">
      <item>package</item>
      <item>import</item>
      <item>as</item>
      <item>default</item>
      <item>else</item>
      <item>not</item>
      <item>some</item>
      <item>every</item>
      <item>in</item>
      <item>if</item>
      <item>contains</item>
      <item>with</item>
      <item>or</item>
    </list>
    <list name="constants">
      <item>true</item>
      <item>false</item>
      <item>null</item>
    </list>
    <list name="globals">
      <item>input</item>
      <item>data</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar char="#" attribute="Comment" context="Comment"/>
        <keyword String="keywords" attribute="Keyword" context="#stay"/>
        <keyword String="constants" attribute="Constant" context="#stay"/>
        <keyword String="globals" attribute="Variable" context="#stay"/>
        <Detect2Chars char="$" char1="&quot;" attribute="String" context="Template"/>
        <DetectChar char="&quot;" attribute="String" context="String"/>
        <DetectChar char="`" attribute="String" context="RawString"/>
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
        <RegExpr String="[a-zA-Z_][a-zA-Z0-9_]*(?=\()" attribute="Function" context="#stay"/>
        <AnyChar String=":=!&lt;&gt;+-*/%|&amp;" attribute="Operator" context="#stay"/>
      </context>
      <context name="Comment" attribute="Comment" lineEndContext="#pop"/>
      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="Special Char" context="#stay"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>
      <context name="Template" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="Special Char" context="#stay"/>
        <DetectChar char="{" attribute="Special Char" context="TemplateExpr"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>
      <context name="TemplateExpr" attribute="Normal Text" lineEndContext="#pop">
        <DetectChar char="}" attribute="Special Char" context="#pop"/>
        <IncludeRules context="Normal"/>
      </context>
      <context name="RawString" attribute="String" lineEndContext="#stay">
        <DetectChar char="`" attribute="String" context="#pop"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Constant" defStyleNum="dsConstant"/>
      <itemData name="Variable" defStyleNum="dsVariable"/>
      <itemData name="Function" defStyleNum="dsFunction"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
      <itemData name="Decimal" defStyleNum="dsDecVal"/>
      <itemData name="Float" defStyleNum="dsFloat"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Special Char" defStyleNum="dsSpecialChar"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" start="#"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
